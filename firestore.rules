rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isChatMember(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid);
      allow update, delete: if isSelf(uid);

      match /contacts/{contactUid} {
        allow read, write: if isSelf(uid);
      }
    }

    match /usernames/{tag} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn()
        && request.resource.data.uid == request.auth.uid;
    }

    match /contacts/{contactId} {
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || resource.data.contactUid == request.auth.uid);
      allow create, update, delete: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
    }

    match /chats/{chatId} {
      allow read: if isChatMember(chatId)
        || (signedIn() && request.auth.uid in resource.data.members);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members;
      allow update: if isChatMember(chatId)
        || (signedIn() && request.auth.uid in request.resource.data.members);
      allow delete: if isChatMember(chatId);

      match /messages/{msgId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isChatMember(chatId);
      }
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;

      match /views/{uid} {
        allow read: if signedIn();
        allow write: if isSelf(uid);
      }

      match /likes/{uid} {
        allow read: if signedIn();
        allow write: if isSelf(uid);
      }
    }
  }
}
